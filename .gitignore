.env.*.local

# Dependencias y compilados de Frontend
frontend/node_modules/
frontend/build/
frontend/coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Configuracion de editores e IDEs
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
